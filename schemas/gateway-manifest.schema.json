{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Alvearium Genesis Gateway Manifest",
  "description": "Provisional v0.1.0 schema for a descriptive gateway manifest. Validation does not establish truth, authority, runtime behaviour, or trust.",
  "type": "object",
  "required": [
    "protocol",
    "manifestVersion",
    "id",
    "created",
    "revision"
  ],
  "properties": {
    "protocol": {
      "const": "alvearium-genesis"
    },
    "manifestVersion": {
      "const": "0.1.0",
      "description": "Version of this manifest schema, not the gateway software version."
    },
    "id": {
      "type": "string",
      "format": "uri",
      "minLength": 1,
      "description": "Gateway identifier. URI syntax is required; no particular identity method is mandated."
    },
    "created": {
      "type": "string",
      "format": "date-time"
    },
    "updated": {
      "type": "string",
      "format": "date-time"
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "description": "Monotonically increasing revision chosen by the gateway. It is not a globally ordered timestamp."
    },
    "displayName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "description": {
      "type": "string",
      "maxLength": 4000
    },
    "createdBy": {
      "type": "string",
      "format": "uri",
      "description": "Optional creator reference. It is an assertion and does not confer ownership or authority."
    },
    "identity": {
      "type": "object",
      "required": [
        "method",
        "subject"
      ],
      "properties": {
        "method": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "subject": {
          "type": "string",
          "format": "uri"
        },
        "verification": {
          "type": "string",
          "format": "uri",
          "description": "Optional reference to identity verification material or instructions."
        }
      },
      "additionalProperties": false
    },
    "lineage": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "relationship",
          "gateway"
        ],
        "properties": {
          "relationship": {
            "enum": [
              "spawned-from",
              "forked-from",
              "derived-from"
            ]
          },
          "gateway": {
            "type": "string",
            "format": "uri"
          },
          "evidence": {
            "type": "string",
            "format": "uri"
          }
        },
        "additionalProperties": false
      }
    },
    "interfaces": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "protocol",
          "version",
          "endpoint"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uri"
          },
          "protocol": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "endpoint": {
            "type": "string",
            "format": "uri"
          },
          "roles": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            }
          },
          "documentation": {
            "type": "string",
            "format": "uri"
          }
        },
        "additionalProperties": false
      }
    },
    "capabilities": {
      "type": "array",
      "description": "Descriptive declarations only. These entries do not grant permission or prove that a capability works.",
      "items": {
        "type": "object",
        "required": [
          "id",
          "direction"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uri"
          },
          "direction": {
            "enum": [
              "offers",
              "requires"
            ]
          },
          "description": {
            "type": "string",
            "maxLength": 2000
          },
          "interface": {
            "type": "string",
            "format": "uri"
          }
        },
        "additionalProperties": false
      }
    },
    "policies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "uri"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uri"
          },
          "uri": {
            "type": "string",
            "format": "uri"
          },
          "mediaType": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        },
        "additionalProperties": false
      }
    },
    "extensions": {
      "type": "object",
      "description": "Extension names must be absolute URI-style namespaces. Unknown non-critical extensions may be ignored. Unknown critical extensions must cause a consumer to reject or explicitly mark the manifest unsupported.",
      "propertyNames": {
        "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:"
      },
      "additionalProperties": {
        "type": "object",
        "required": [
          "critical",
          "value"
        ],
        "properties": {
          "critical": {
            "type": "boolean"
          },
          "value": {}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
